/target
**/*.rs.bk
*.pdb

# Secrets. `tenants.yaml` references keys by env var; never commit the values.
.env
.env.*
*.key
*.pem

# Local scratch
/logs
*.log

# The default SQLite ledger, created next to the config it is run with.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Per-replica Wicket receipt chain (log, anchor, signing key).
/receipts/
signing.priv

# Python bytecode from tools/ and demo scripts
__pycache__/

# Real-conversation corpora for tools/fold_retention.py --corpus.
# Raw chat exports stay here and are never committed.
/corpus/
